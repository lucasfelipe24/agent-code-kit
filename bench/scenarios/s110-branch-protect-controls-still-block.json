{
  "name": "s110-branch-protect-controls-still-block",
  "steps": [
    {
      "hook": ".claude/hooks/branch-protect.sh",
      "payload": { "tool_name": "Bash", "tool_input": { "command": "git push -f origin feat/x" } },
      "expect": { "exit_code": 2, "stdout_empty": true, "stderr_starts_with": "BLOCKED", "stderr_contains": ["Force push"] }
    },
    {
      "hook": ".claude/hooks/branch-protect.sh",
      "payload": { "tool_name": "Bash", "tool_input": { "command": "git push origin main" } },
      "expect": { "exit_code": 2, "stdout_empty": true, "stderr_starts_with": "BLOCKED" }
    },
    {
      "hook": ".claude/hooks/branch-protect.sh",
      "payload": { "tool_name": "Bash", "tool_input": { "command": "bash -c \"git push origin main\"" } },
      "expect": { "exit_code": 2, "stdout_empty": true, "stderr_starts_with": "BLOCKED" }
    }
  ],
  "notes": "Controls for the per-segment rewrite (s106-s109): -f, a plain push to main, and a push inside bash -c still block."
}
