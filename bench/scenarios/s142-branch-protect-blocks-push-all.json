{
  "name": "s142-branch-protect-blocks-push-all",
  "setup_commands": ["git init -q . && git symbolic-ref HEAD refs/heads/feat/search"],
  "steps": [
    {
      "hook": ".claude/hooks/branch-protect.sh",
      "payload": { "tool_name": "Bash", "tool_input": { "command": "git push --all" } },
      "expect": { "exit_code": 2, "stdout_empty": true, "stderr_starts_with": "BLOCKED", "stderr_contains": ["--all"] }
    },
    {
      "hook": ".claude/hooks/branch-protect.sh",
      "payload": { "tool_name": "Bash", "tool_input": { "command": "git push origin --all" } },
      "expect": { "exit_code": 2, "stdout_empty": true, "stderr_starts_with": "BLOCKED", "stderr_contains": ["--all"] }
    },
    {
      "hook": ".claude/hooks/branch-protect.sh",
      "payload": { "tool_name": "Bash", "tool_input": { "command": "git push -u --branches origin" } },
      "expect": { "exit_code": 2, "stdout_empty": true, "stderr_starts_with": "BLOCKED" }
    }
  ],
  "notes": "git push --all (alias --branches) pushes every local branch, main/master included. From a feature branch it passed (exit 0); it now blocks like --mirror (s108)."
}
