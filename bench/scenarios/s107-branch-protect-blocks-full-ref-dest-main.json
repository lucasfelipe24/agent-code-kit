{
  "name": "s107-branch-protect-blocks-full-ref-dest-main",
  "steps": [
    {
      "hook": ".claude/hooks/branch-protect.sh",
      "payload": { "tool_name": "Bash", "tool_input": { "command": "git push origin HEAD:refs/heads/main" } },
      "expect": { "exit_code": 2, "stdout_empty": true, "stderr_starts_with": "BLOCKED", "stderr_contains": ["main/master"] }
    },
    {
      "hook": ".claude/hooks/branch-protect.sh",
      "payload": { "tool_name": "Bash", "tool_input": { "command": "git push origin feat:main" } },
      "expect": { "exit_code": 2, "stdout_empty": true, "stderr_starts_with": "BLOCKED" }
    }
  ],
  "notes": "A refspec destination spelled as a full ref (refs/heads/main) passed (exit 0); destinations are compared without the refs/heads/ prefix."
}
