{
  "name": "s155-protect-changes-blocks-ef-core-and-alembic-migrations",
  "steps": [
    {
      "hook": ".claude/hooks/protect-changes.sh",
      "payload": { "tool_name": "Write", "tool_input": { "file_path": "{TMPROOT}/src/Infrastructure/Migrations/20260101120000_InitialCreate.cs" } },
      "expect": { "exit_code": 2, "stdout_empty": true, "stderr_contains": ["BLOCKED", "database migration/schema"] }
    },
    {
      "hook": ".claude/hooks/protect-changes.sh",
      "payload": { "tool_name": "Edit", "tool_input": { "file_path": "{TMPROOT}/src/Infrastructure/Data/AppDbContextModelSnapshot.cs" } },
      "expect": { "exit_code": 2, "stdout_empty": true, "stderr_contains": ["BLOCKED", "database migration/schema"] }
    },
    {
      "hook": ".claude/hooks/protect-changes.sh",
      "payload": { "tool_name": "Write", "tool_input": { "file_path": "Migrations/20260101120000_InitialCreate.Designer.cs" } },
      "expect": { "exit_code": 2, "stdout_empty": true, "stderr_contains": ["BLOCKED"] }
    },
    {
      "hook": ".claude/hooks/protect-changes.sh",
      "payload": { "tool_name": "Write", "tool_input": { "file_path": "{TMPROOT}/alembic/versions/0001_create_users.py" } },
      "expect": { "exit_code": 2, "stdout_empty": true, "stderr_contains": ["BLOCKED", "database migration/schema"] }
    },
    {
      "hook": ".claude/hooks/protect-changes.sh",
      "payload": { "tool_name": "Write", "tool_input": { "file_path": "alembic/versions/0002_add_email.py" } },
      "expect": { "exit_code": 2, "stdout_empty": true, "stderr_contains": ["BLOCKED"] }
    }
  ],
  "notes": "EF Core's Migrations/ (capital M) and *ModelSnapshot.cs, and Alembic's alembic/versions/, passed (exit 0) although examples/dotnet and examples/python-fastapi declare them protected."
}
